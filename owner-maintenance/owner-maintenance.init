#!/bin/sh
# Bounded, non-blocking SysV hook; never block S99boot-ok or control vendor services.
BASE=/data/owner-maintenance/bootstrap
PYTHON=/usr/bin/python3.5
EXPECTED=@BOOTSTRAP_SHA256@
[ -r "$BASE/bootstrap.py" ] || exit 0
actual=$(sha256sum "$BASE/bootstrap.py") || exit 0
[ "${actual%% *}" = "$EXPECTED" ] || exit 0
case "$1" in
 start) "$PYTHON" -E -B -S "$BASE/bootstrap.py" run </dev/null >/dev/null 2>&1 & ;;
 stop) "$PYTHON" -E -B -S "$BASE/bootstrap.py" stop </dev/null >/dev/null 2>&1 || exit $? ;;
 restart) "$PYTHON" -E -B -S "$BASE/bootstrap.py" stop </dev/null >/dev/null 2>&1 || exit $?
          "$PYTHON" -E -B -S "$BASE/bootstrap.py" run </dev/null >/dev/null 2>&1 & ;;
 *) exit 2 ;;
esac
exit 0
