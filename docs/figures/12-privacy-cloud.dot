digraph G {
graph [rankdir=LR,bgcolor="white",pad="0.2",nodesep="0.35",ranksep="0.45",label="Privacy policy boundaries",labelloc=t,fontname="DejaVu Sans",fontsize=17];
node [shape=box,style="rounded,filled",fillcolor="#eef3f8",color="#415a77",fontname="DejaVu Sans",fontsize=11,margin="0.14,0.1"];
edge [color="#415a77",fontname="DejaVu Sans",fontsize=9];
printer [label="Printer local state / logs / job\nstatus"];
optional [label="Optional collection/privacy\nsettings"];
gateway [label="Cloud gateway / Dashboard /\nremote printing"];
cloud [label="Manufacturer services"];
host [label="PreForm computer / host-mediated\npaths"];
fence [label="Independent local-only network\nboundary"];
printer -> optional [label=""];
printer -> gateway [label="required status may include\nusage/identifiers",style=dashed];
optional -> cloud [label="only if verified enabled path",style=dashed];
gateway -> cloud [label="cloud mode retains residual\ninformation"];
host -> cloud [label="printer-only blocking is\ninsufficient",style=dashed];
fence -> cloud [label="local-only blocks egress;\nremoves cloud functions",style=dashed];
}
